{
  "name": "si202-web-framework-css",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "sass": "sass scss/style.scss app/style.css && sass scss/home.scss app/index.css && sass scss/pages/produto.scss app/pages/produto/produto.css && sass scss/pages/categorias.scss app/pages/categorias/categorias.css",
    "sass:watch": "sass --watch scss/style.scss:app/style.css scss/home.scss:app/index.css scss/pages/produto.scss:app/pages/produto/produto.css scss/pages/categorias.scss:app/pages/categorias/categorias.css",
    "api": "json-server --watch db/db.json --port 3000",
    "copy-libs": "node scripts/copy-libs.js",
    "postinstall": "node scripts/copy-libs.js",
    "build:dist": "node scripts/build-dist.js",
    "lint": "eslint app/ scripts/",
    "format": "prettier --write \"app/**/*.js\" \"scripts/**/*.js\" \"scss/**/*.scss\"",
    "predeploy": "npm run copy-libs && npm run build:dist",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Projeto da disciplina SI202 - Desenvolvimento de Páginas Web com Framework e CSS",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "jquery-mask-plugin": "^1.14.16",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "gh-pages": "^6.3.0",
    "json-server": "^0.17.4",
    "prettier": "^3.9.6",
    "sass": "^1.104.1"
  }
}
